rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Feed Posts
    match /posts/{postId} {
      allow read, write: if true;

      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // Official Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Tasks / To-dos
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /user_tasks/{taskId} {
      allow read, write: if true;
    }

    // Gestão Funerária - Ordens de Serviço
    match /funeraria_os/{osId} {
      allow read, write: if true;
    }

    // Gestão Funerária - Pesquisas de Satisfação
    match /funeraria_satisfaction_surveys/{surveyId} {
      allow read, write: if true;
    }

    // Configurações do sistema (Branding / Favicon / Logos)
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // POPs
    match /pops/{popId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

